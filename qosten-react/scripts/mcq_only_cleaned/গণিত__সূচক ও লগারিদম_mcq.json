  {
    "id": 1768139842365,
    "subject": "গণিত",
    "chapter": "সূচক ও লগারিদম",
    "question": "\\(\\frac{4^n - 1}{2^n + 1}\\) এর মান নিচের কোনটি?",
    "options": "[{\"label\":\"a\",\"text\":\"\\\\(2^{n+1}\\\\)\",\"is_correct\":false},{\"label\":\"b\",\"text\":\"\\\\(2^{n-1}\\\\)\",\"is_correct\":false},{\"label\":\"c\",\"text\":\"\\\\(2^n - 1\\\\)\",\"is_correct\":true},{\"label\":\"d\",\"text\":\"\\\\(2^n + 1\\\\)\",\"is_correct\":false}]",
    "correctAnswer": "c",
    "explanation": "লবকে বর্গের সূত্র অনুযায়ী উৎপাদকে বিশ্লেষণ করি:\n\\(4^n - 1 = (2^2)^n - 1^2 = (2^n)^2 - 1^2\\)\n\\(= (2^n - 1)(2^n + 1)\\)\nএখন রাশিটিতে বসিয়ে পাই:\n\\(\\frac{(2^n - 1)(2^n + 1)}{2^n + 1} = 2^n - 1\\)",
    "image": null,
    "language": "en"
  },
